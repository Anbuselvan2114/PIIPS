<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Defaults are far too small for a multi-PDF File Explorer upload:
         requestFiltering caps any single request at ~30MB, and ARR's own
         proxy forwarding (this rule's absolute-URL rewrite requires ARR)
         caps a forwarded request at just 4MB regardless - either one
         alone throws IIS's own 413 "Request Entity Too Large" before the
         request ever reaches the FastAPI backend, no matter what limits
         (or lack thereof) the Python side sets. Raised to 500MB, generous
         for a large batch of PDFs. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
    <proxy enabled="true" maxForwardedRequestLength="524288000" responseBufferLimit="0" />
  </system.webServer>
  <appSettings>
    <!-- folder_path is intentionally NOT set here: config_store.load_config()
         treats web.config's folder_path as authoritative over config.json
         whenever present, and this file (unlike config.json) IS copied to
         every environment on Publish (deploy.py's robocopy only excludes
         config.json) - a value hardcoded here would overwrite each
         environment's own real folder path on every publish. Each
         environment's Folder Configuration screen writes its own value
         straight into ITS config.json instead (config_store.save_config),
         which is never touched by a publish. -->
  </appSettings>
</configuration>